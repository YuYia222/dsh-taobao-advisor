{
  "name": "@local/dsh-taobao-advisor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sidebar Taobao picker: sign in once, name a model, compare price, value and performance, and ask sellers for you.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
